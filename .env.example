# SOPscape Council — environment variables
# Real values go in deployment secret manager or uncommitted local .env

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SOPSCAPE_DATABASE_PATH=./data/sopscape.sqlite
SOPSCAPE_API_KEY=replace-with-a-long-random-token
SOPSCAPE_REQUIRE_AUTH=true
SOPSCAPE_OWNER_PASSWORD=replace-with-at-least-12-characters
SOPSCAPE_SESSION_SECRET=replace-with-a-long-random-session-secret
RATE_LIMIT_PER_MINUTE=120
OKX_PUBLIC_FREE_A2MCP=false
PUBLIC_A2MCP_RATE_LIMIT_PER_MINUTE=6
MODEL_API_KEY=replace-with-real-key
MODEL_BASE_URL=https://api.okx.ai/v1
MODEL_NAME=replace-with-real-model
PUBLIC_APP_ORIGIN=http://localhost:3000
TRUSTED_PROXY_CIDR=
PROVIDER_DAILY_SPEND_USD=50

# HTTPS — terminate at Nginx, Cloudflare, or deployment platform gateway
# USE_HTTPS=false
# SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem
